# Copie este arquivo para .env e preencha só no seu computador. O .env nunca vai para o Git.
# Valores reais de produção ficam nos Secrets da hospedagem.

# Supabase (Etapa 1b e 2)
SUPABASE_URL=
SUPABASE_KEY=
# Chave secreta (sb_secret_...): só no servidor. A IA usa para escolher o modelo e registrar o uso (Etapa 6).
SUPABASE_SECRET_KEY=

# Provedores de IA (Etapa 6)
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Gemini e OpenRouter treinam com os dados no plano grátis: ficam desligados no catálogo.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Endereço público do site, sem barra no fim (ex.: https://nome-do-projeto.vercel.app). Usado na imagem de prévia do link,
# no robots.txt e no sitemap. Vazio no computador: usa o endereço de quem abriu a página.
NUXT_PUBLIC_SITE_URL=
